@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol HubEventProtocol {

    // Типы устройств
    enum DeviceTypeAvro {
        MOTION_SENSOR,
        TEMPERATURE_SENSOR,
        LIGHT_SENSOR,
        CLIMATE_SENSOR,
        SWITCH_SENSOR
    }

    // Типы условий
    enum ConditionTypeAvro {
        MOTION,
        LUMINOSITY,
        SWITCH,
        TEMPERATURE,
        CO2LEVEL,
        HUMIDITY
    }

    // Операции сравнения
    enum ConditionOperationAvro {
        EQUALS,
        GREATER_THAN,
        LOWER_THAN
    }

    // Типы действий
    enum ActionTypeAvro {
        ACTIVATE,
        DEACTIVATE,
        INVERSE,
        SET_VALUE
    }

    // Условие сценария
    record ScenarioConditionAvro {
        string sensorId;
        ConditionTypeAvro type;
        ConditionOperationAvro operation;
        int value;
    }

    // Действие устройства
    record DeviceActionAvro {
        string sensorId;
        ActionTypeAvro type;
        union { null, int } value = null;
    }

    // Событие: добавление устройства
    record DeviceAddedAvro {
        string id;
        DeviceTypeAvro deviceType;
    }

    // Событие: удаление устройства
    record DeviceRemovedAvro {
        string id;
    }

    // Событие: добавление сценария
    record ScenarioAddedAvro {
        string name;
        array<ScenarioConditionAvro> conditions;
        array<DeviceActionAvro> actions;
    }

    // Событие: удаление сценария
    record ScenarioRemovedAvro {
        string name;
    }

    // Главное событие хаба
    record HubEventAvro {
        string hubId;
        long timestamp;  // timestamp-millis будет добавлено отдельно
        union {
            null,
            DeviceAddedAvro,
            DeviceRemovedAvro,
            ScenarioAddedAvro,
            ScenarioRemovedAvro
        } payload;
    }
}